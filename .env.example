# Copy to .env and fill in. Never commit the real .env file.

# Database password for the bundled PostgreSQL container (choose a long random value).
POSTGRES_PASSWORD=

# Public address people use to open the portal, e.g. https://portal.example.com.au
# Used in invitation and reset links. Leave empty to use the address in the admin's browser.
PUBLIC_BASE_URL=

# First-time setup key. Choose a long random value. Whoever knows it can create the
# organisation and become its account holder, once, on an empty install.
# After setup is complete you can blank this line and restart.
SETUP_KEY=

# Key that protects sensitive details stored in the database (dates of birth, tax file numbers,
# and later integration passwords). Generate one with:
#   docker compose run --rm api python -m app.seed generate-key
# Keep a copy somewhere safe and separate from the database backups. If this key is lost or
# changed, the protected details already saved cannot be read again.
ENCRYPTION_KEY=

# Outbound email and text messages. "on" locks safe mode on: nothing is ever sent, whatever is
# switched on inside the portal. Leave it "on" until the connections are set up and tested and you
# are ready for the portal to send real messages. "off" lets the switch inside the portal decide
# (that switch also starts "on").
COMMS_SAFE_MODE=on

# Port the portal is published on.
WEB_PORT=3960

# Session policy (defaults shown).
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30
IDLE_TIMEOUT_MINUTES=240

# Folder on the server where backup archives are written. Use a folder on a different disk from the
# database if you can (for example a NAS shared folder). The portal runs as user id 10001 inside its
# container, so that user must be allowed to write there:  chown 10001 <folder>
BACKUP_PATH=./backups
# How many archives "Tidy up" keeps. Nothing is removed until you press the button.
BACKUP_KEEP=14
# Optional: the code version this install was built from, shown on the System check screen.
GIT_COMMIT=
